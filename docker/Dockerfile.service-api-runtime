FROM maven:3.9.11-eclipse-temurin-25 AS build
WORKDIR /workspace
COPY . .
RUN mvn -pl trio-base-services/service-api-runtime -am -DskipTests package

FROM eclipse-temurin:21-jre
RUN useradd --system --uid 10001 triobase
WORKDIR /app
COPY --from=build /workspace/trio-base-services/service-api-runtime/target/service-api-runtime-*.jar app.jar
USER triobase
EXPOSE 8095
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-jar", "/app/app.jar"]
